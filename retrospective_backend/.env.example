# Configuration de l'API
PORT=8000

# Configuration de la base de données (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=retrospective_user
DB_PASSWORD=retrospective_password
DB_NAME=retrospective

# Si vous lancez le backend hors Docker avec la DB du docker-compose,
# utilisez DB_HOST=localhost et DB_PORT=3308.
# Dans Docker Compose, ces variables sont fournies directement au service backend :
# DB_HOST=db
# DB_PORT=3306

# jsonwebtoken
# Générer une valeur unique hors dépôt, par exemple :
# openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h

# Envoi d'emails transactionnels via SMTP Brevo.
# Ne jamais versionner de vrais identifiants SMTP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="Range Ta Chambre <no-reply@rangetachambre.com>"
