# Modèle de configuration pour la production (VPS).
# Ce fichier ne contient AUCUNE vraie valeur : il sera copié en `.env` sur le
# VPS (/srv/apps/retrospective/.env), rempli avec les vraies valeurs, puis
# jamais commité ni versionné.

# Base de données MySQL
DB_NAME=retrospective
DB_USER=retrospective_user
DB_PASSWORD=replace_with_a_strong_password
DB_ROOT_PASSWORD=replace_with_a_strong_root_password

# jsonwebtoken
# Générer une valeur unique et secrète, par exemple :
# openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret

# Envoi d'emails transactionnels via SMTP Brevo.
# Ne jamais versionner de vrais identifiants SMTP.
SMTP_USER=
SMTP_PASS=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="Retrospective <no-reply@elyasbenyoub.dev>"

# URL de l'API utilisée par le frontend au moment du build.
# Laisser vide : le frontend utilise alors une URL relative, ce qui évite
# de devoir rebuilder l'image si le domaine ou le protocole (http/https)
# change un jour (cf. leçon apprise sur le projet la-loge).
VITE_API_URL=
